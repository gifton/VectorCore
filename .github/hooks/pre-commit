#!/bin/bash
# Install with: bash .github/hooks/install-hooks.sh
# Checks working-tree contents for staged Swift paths, as a local convenience.
set -euo pipefail

cd -- "$(git rev-parse --show-toplevel)"
file_list="$(mktemp)"
trap 'rm -f -- "$file_list"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$file_list"
count=0
while IFS= read -r -d '' path; do
    case "$path" in
        *.swift)
            export "SCRIPT_INPUT_FILE_$count=$path"
            count=$((count + 1))
            ;;
    esac
done < "$file_list"
if [ "$count" -eq 0 ]; then
    echo "No staged Swift files to lint."
    exit 0
fi
if ! command -v swiftlint >/dev/null 2>&1; then
    echo "SwiftLint is unavailable; skipping the optional local lint check." >&2
    exit 0
fi
export SCRIPT_INPUT_FILE_COUNT="$count"
echo "Running SwiftLint on $count staged Swift paths."
swiftlint lint --use-script-input-files
